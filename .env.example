PORT=8000
EXPORT_EMAILS=chaz@vnsfirm.com

# Local development uses SQLite when DATABASE_URL is empty.
# Render will inject this automatically from the managed Postgres database.
DATABASE_URL=

# Required for automatic CSV export emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASSWORD=smtp-password
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true
